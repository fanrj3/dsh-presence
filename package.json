{
  "name": "@rjfan/dsh-presence",
  "version": "0.17.7",
  "type": "module",
  "description": "Work on any machine in your ssh config as if it were local: persistent connections, native file editing, search, exec and terminals, with nothing installed on the remote host.",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./fs": "./src/fs-provider.js",
    "./selfcheck": "./src/fs-selfcheck.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src/**/*.js",
    "src/**/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "probe": "node scripts/probe.mjs",
    "build:client": "node scripts/build-client.mjs"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^1.0.2",
    "codemirror": "^6.0.2",
    "rollup": "^4.65.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-fs": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0 || >=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-fs-sandbox": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0 || >=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0 || >=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0 || >=0.2.1-rc.1 <0.3.0-0"
  },
  "license": "MIT",
  "author": "fanrj3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fanrj3/dsh-presence.git"
  },
  "bugs": {
    "url": "https://github.com/fanrj3/dsh-presence/issues"
  },
  "homepage": "https://github.com/fanrj3/dsh-presence#readme",
  "keywords": [
    "dsh-plugin",
    "ssh",
    "remote-development",
    "terminal",
    "mcp",
    "agent-tools"
  ],
  "publishConfig": {
    "access": "public"
  }
}
